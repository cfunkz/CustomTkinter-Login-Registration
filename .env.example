# Copy this file to .env and set only the values you want to change.
# Anything left out uses the default from config.py. Never commit your .env file.

# ---------------------------------------------------------------- Application
# APP_NAME=Title Placement

# ---------------------------------------------------------------- Appearance
# APPEARANCE_MODE=System          # System, Light or Dark
# COLOR_THEME=blue                # blue, green, dark-blue or a path to a theme .json
# ACCENT_COLOR=#3B82F6
# ACCENT_HOVER_COLOR=#2563EB
# DANGER_COLOR=#EF4444
# DANGER_HOVER_COLOR=#DC2626
# SUCCESS_COLOR=#22C55E
# FONT_FAMILY=Segoe UI           # Default: Segoe UI on Windows, Helvetica Neue on macOS, DejaVu Sans on Linux
# UI_SCALING=1.0

# ---------------------------------------------------------------- Windows
# AUTH_WINDOW_SIZE=520x640
# DASHBOARD_WINDOW_SIZE=1100x680
# WINDOW_RESIZABLE=false

# ---------------------------------------------------------------- Database
# The SQLite file is saved in one fixed folder per user:
# Windows %APPDATA%\TitlePlacement, macOS ~/Library/Application Support/TitlePlacement, Linux ~/.local/share/TitlePlacement
# DATA_FOLDER=TitlePlacement
# DATABASE_TYPE=sqlite            # sqlite, postgres or mysql
# DATABASE_FILE=                  # Full path to use another SQLite file

# PostgreSQL (pip install psycopg2-binary) or MySQL / MariaDB (pip install PyMySQL)
# DATABASE_HOST=localhost
# DATABASE_PORT=5432              # 5432 for PostgreSQL, 3306 for MySQL
# DATABASE_NAME=user_database
# DATABASE_USER=
# DATABASE_PASSWORD=

# ---------------------------------------------------------------- Security
# MIN_PASSWORD_LENGTH=8
# MAX_LOGIN_ATTEMPTS=5
# LOCKOUT_MINUTES=5
# MAX_SECURITY_ATTEMPTS=3
# HASH_ITERATIONS=310000
# TEMPORARY_PASSWORD_LENGTH=12

# ---------------------------------------------------------------- Email (SMTP)
# Gmail app password: https://myaccount.google.com/apppasswords
SMTP_USERNAME=
SMTP_PASSWORD=
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_TIMEOUT=15
# SENDER_EMAIL=

# ---------------------------------------------------------------- OAuth
# Register this redirect URI with every provider: http://localhost:8765/callback
# OAUTH_PROVIDERS=google,facebook,discord   # Buttons shown on the login screen, in this order
# OAUTH_REDIRECT_HOST=localhost
# OAUTH_REDIRECT_PORT=8765
# OAUTH_REDIRECT_PATH=/callback
# OAUTH_TIMEOUT=120
# OAUTH_LINK_BY_EMAIL=true

# Google: https://console.cloud.google.com/apis/credentials (OAuth client ID, type "Desktop app")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook: https://developers.facebook.com/apps (Facebook Login product)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# FACEBOOK_API_VERSION=v19.0

# Discord: https://discord.com/developers/applications (OAuth2 > Redirects)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
